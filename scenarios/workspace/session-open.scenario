# KEYMAP.md §Hub › Worktrees pane (`Enter`, `o` — open session → Workspace) and
# §Modes and key contexts (Terminal is entered by opening a worktree session).
# UX-SPEC.md §3.6 for what the Workspace shows: the session's terminal tabs.
#
# `one-repo` seeds one repository with one worktree, so the first row is the only row and
# `o` is the whole of "open a session" with nothing to choose first.
fixture: one-repo
await idle
assert screen == Hub && hub_tab == Worktrees && focused == worktrees.row[0]

# Opening the session replaces the Hub with the Workspace, and lands in Terminal mode.
key o
await screen == Workspace 20000
assert mode == Terminal && key_contexts[0] == Workspace && key_contexts[1] == Terminal

# config.json's three default windows (fleet-core `config.rs`): two PTYs, then Fleet's own
# git pane, which is a `fleet://` tab rather than a process.
await lists.tabs.rows[2] exists 20000
assert lists.tabs.rows[0].badges[0] == pty && lists.tabs.rows[1].badges[0] == pty
assert lists.tabs.rows[2].label == lg && lists.tabs.rows[2].badges[0] == native

# The first tab is selected, and it is the tab — not the grid — that owns focus.
await lists.tabs.selected.id == 1 20000
assert focused == tabs.tab[0]
shot workspace
dump workspace

# Nothing about opening a session is asynchronous once the tabs are up.
await idle
quit
