# KEYMAP.md §Jobs panel (`J`) — open, expand a log, collapse it, close restoring prior focus
#
# The `busy` preset's own start-up work is what fills the panel: fetching pull requests for two
# repositories is four real daemon jobs, so the panel has rows without a scenario injecting any.
# `Esc` is the interesting key here — it collapses an expanded log and only closes the panel on
# the second press, which is checked by asserting the panel is *still* open in between.
fixture: busy
await idle 30000
await lists.jobs.rows[0] exists 30000
assert screen == Hub && overlay absent && focused == worktrees.row[0]

# `J` opens the panel. It is an overlay: its own key context, its own focus owner.
key J
await overlay == Jobs
assert mode == Jobs && key_contexts[0] == Jobs && focused == jobs.row[0]
assert lists.jobs.selected exists && lists.jobs.rows[0].id ~= "^job-"
shot jobs
dump jobs

# `Enter` expands the selected job's log; the panel stays open ...
key enter
await idle
assert overlay == Jobs && mode == Jobs && key_contexts[0] == Jobs
dump expanded

# ... `Esc` collapses the log and the panel is *still* open ...
key escape
await idle
assert overlay == Jobs && mode == Jobs && focused == jobs.row[0]

# ... and `q` closes it, restoring the pane, row and mode the Hub had before.
key q
await overlay absent
assert screen == Hub && mode == Normal && hub_pane == List && focused == worktrees.row[0]
dump closed
quit
