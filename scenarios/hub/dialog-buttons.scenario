# UX-SPEC §3.8 · ADR 0023 · TESTING-HARNESS.md §3 (`dialog.button[N]`, `dialog.row[N]`) — the Hub's
# dialogs on the button footer: New context, Move repo, Repository hooks and Clone repo each paint
# `Cancel` as `dialog.button[0]`, and a click on it runs what `esc` runs, so the dialog closes and
# the keyboard goes back where it came from. The shots are the review of each footer.
fixture: busy
await idle 30000
assert screen == Hub && mode == Normal && overlay absent

key N
await overlay == Dialog 10000
await idle 10000
assert dialog.name == Context && targets["dialog.button[0]"] exists && targets["dialog.button[1]"] exists
type Pointer team
assert dialog.fields[0].value == "Pointer team"
shot context-new
click dialog.button[0]
await overlay absent 10000
assert screen == Hub && dialog absent && focused == worktrees.row[0]

# The repos pane owns `m`, `e` and `n`; its second row is `acme/api`.
key h
await hub_pane == Repos
key j
assert lists.repos.rows[1].label == "acme/api"

key m
await overlay == Dialog 10000
assert dialog.name == Assign && targets["dialog.row[0]"] exists && targets["dialog.button[1]"] exists
shot assign-repo
click dialog.button[0]
await overlay absent 10000
assert dialog absent && hub_pane == Repos

key e
await overlay == Dialog 10000
await idle 10000
assert dialog.name == Hooks && targets["dialog.button[1]"] exists
type cargo build
assert dialog.fields[0].value == "cargo build"
shot hooks-edit
click dialog.button[0]
await overlay absent 10000
assert dialog absent && hub_pane == Repos

key n
await overlay == Dialog 10000
await idle 10000
assert dialog.name == Clone && targets["dialog.button[1]"] exists
shot clone-repo
click dialog.button[0]
await overlay absent 10000
assert dialog absent && hub_pane == Repos
dump closed
quit
