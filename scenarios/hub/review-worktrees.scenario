# UX-SPEC §3.3 — review worktrees (`pull/<n>/head` checkouts) are hidden from the Worktrees list
# by default; the subtitle's `worktrees.reviews` button and `v` show and hide them again.
# KEYMAP.md §Hub › Worktrees pane — `v` show / hide review worktrees.
#
# The `busy` preset checks `acme/api#21` out as `acme/api#banner` through `CreateWorktreeFromPr`,
# so the daemon itself writes its `pull/21/head` base; it is created last and so is the newest
# worktree, which puts it first in the sort once it is shown. The oracle is the row count, the
# `review` mark and the branch badge: hidden, the list is busy's four worktrees of its own and
# none is marked; shown, a fifth row carries both. `focused` pins that showing a row above the
# cursor keeps the cursor on the same worktree rather than the same index (§3.3 Cursor stability).
# The filter narrows only the visible list, so typing the review's branch finds nothing while it
# is hidden. A headless `await` does not repaint (§11), so the target is read with `assert`.
#
# No `shot`: this is a keyboard scenario, so it belongs in the headless subset too (§7).
fixture: busy
await idle 30000
assert screen == Hub && hub_pane == List && hub_tab == Worktrees && focused == worktrees.row[0]
assert lists.worktrees.rows[3] exists && lists.worktrees.rows[4] absent
assert lists.worktrees.rows[0].label == spike && lists.worktrees.rows[0].marks[0] absent
assert lists.worktrees.rows[1].marks[0] == degraded && lists.worktrees.rows[2].marks[0] absent && lists.worktrees.rows[3].marks[0] absent
assert targets["worktrees.reviews"] exists

# The filter does not bring a hidden review worktree back.
key /
await overlay == Filter 10000
type banner
await lists.worktrees.filter == banner 10000
await lists.worktrees.rows[0] absent
key escape escape
await lists.worktrees.filter == "" 10000
assert overlay absent && lists.worktrees.rows[3] exists && lists.worktrees.rows[4] absent

# `v` shows it: a fifth row, first in the sort, marked `review`, with the pull request's branch.
key v
await lists.worktrees.rows[4] exists
assert lists.worktrees.rows[0].label == banner && lists.worktrees.rows[0].badges[0] == banner
assert lists.worktrees.rows[0].marks[0] == review && lists.worktrees.rows[0].id == "acme/api#banner"
assert focused == worktrees.row[1] && lists.worktrees.selected.label == spike
assert targets["worktrees.reviews"] exists
dump shown

# `v` again hides it, and the cursor stays on the worktree it was on.
key v
await lists.worktrees.rows[4] absent
assert lists.worktrees.rows[0].label == spike && focused == worktrees.row[0]
dump hidden
quit
