# Phase 3 acceptance — every pointer path Fleet actually paints, end to end.
#
# Fleet's Hub rows carry no click handler (`views/worktrees_list.rs`, `views/repos_rail.rs`,
# `views/prs_screen.rs` and `screens/jobs/presentation.rs` register none), so a row is *named*
# for the pointer but only *opened* from the keyboard. The title bar's section nav is the Hub
# control with an `on_select`, so that is what the click half of this scenario drives.
fixture: one-repo
await idle
assert screen == Hub && hub_tab == Worktrees

# Click the title bar's section nav through all three Hub sections and back.
click hub.tab[1]
await hub_tab == Prs && screen == Hub
shot prs-tab
click hub.tab[2]
await hub_tab == Board && screen == Hub
shot board-tab
click hub.tab[0]
await hub_tab == Worktrees && screen == Hub

# Move and hover resolve a named target and answer only after the frame painted.
move repos.row[1]
hover worktrees.row[0] 100
await idle

# The wheel is GPUI-signed: negative dy scrolls the content down, 18 logical pixels per unit.
scroll 0 -2 at worktrees.row[0]
await idle
dump after-pointer

# Open the session from the keyboard, because the row has no pointer affordance, ...
key o
await screen == Workspace 20000
shot workspace
dump workspace

# ... and close it from the keyboard too: `ctrl-s s` returns to the Hub, session still running.
key ctrl-s s
await screen == Hub
quit
