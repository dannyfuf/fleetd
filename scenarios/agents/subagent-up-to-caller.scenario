# plans/native-subagents-2026-09-17-phase-4-plan.md P4-T07 — `^s u` from an attached
# child returns to its caller and focuses the caller composer.
fixture: agents-subagent
await idle
key o
await screen == Workspace 20000
key ctrl-s a
await agents.threads[0].provider == claude 20000
assert focused == agents.composer
await idle 30000
type delegate the path lookup
key enter
await agents.delegations[0].status == working 30000
key ctrl-s d
await lists.palette.rows[1].badges[1] == child 10000
key down
key enter
await agents.threads[1].attached == true 20000
assert lists.tabs.selected.badges[1] == child

key ctrl-s u
await lists.tabs.selected.badges[0] == claude 20000
assert lists.tabs.selected.badges[1] absent && agents.threads[0].attached == true
assert mode == Agent && focused == agents.composer
dump caller-selected
quit
