# docs/NATIVE-AGENTS.md §7 — Codex effort rows come from the selected model's
# `supportedReasoningEfforts`, keep the provider descriptions, and never use a hardcoded ladder.
#
# An open picker owns `Enter`: accepting the highlighted effort keeps the draft in the composer.
# Sending it with the following `Enter` proves the menu was non-empty.
fixture: agents
await idle
key o
await screen == Workspace 20000

key ctrl-s A
await agents.threads[0].provider == codex 20000
assert lists.tabs.selected.badges[0] == codex && agents.threads[0].state == idle && focused == agents.composer
await idle 30000
type apply the README fix

key ctrl-s e
key enter
wait 500
assert agents.threads[0].state == idle && agents.threads[0].pending_gate absent
dump effort-menu-kept-the-draft

key enter
await agents.threads[0].pending_gate == permission 30000
dump draft-survived
key n
await agents.threads[0].state == idle 30000
assert sticky_error absent
quit
