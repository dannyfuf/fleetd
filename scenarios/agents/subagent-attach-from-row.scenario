await agents.threads[0].delegation_rows == 1 30000
key ctrl-s [
await mode == Scroll 10000
key k
await agents.threads[0].focused_row == delegation 10000
key enter
await agents.threads[1].attached == true 20000
assert lists.tabs.selected.badges[0] == codex && lists.tabs.selected.badges[1] == child
