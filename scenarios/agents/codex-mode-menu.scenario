# docs/NATIVE-AGENTS.md §7 — Codex's access picker contains only its declared modes.
# The FullAccess default is omitted as the current row, so Enter picks Ask and keeps the draft;
# sending it then reaches the scripted approval gate.
fixture: agents
await idle
key o
await screen == Workspace 20000

key ctrl-s A
await agents.threads[0].provider == codex 20000
await idle 30000
type apply the README fix
key ctrl-s t
key enter
assert agents.threads[0].state == idle && lists.tabs.selected.label == Codex
dump codex-mode-menu-kept-the-draft

key enter
await agents.threads[0].pending_gate == permission 30000
key n
await agents.threads[0].state == idle 30000
assert sticky_error absent
quit
