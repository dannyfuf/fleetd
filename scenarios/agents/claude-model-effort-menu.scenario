# docs/NATIVE-AGENTS.md §7 — Claude's model and effort rows come from initialize.models.
# Each open picker owns Enter, so accepting both selections must preserve the draft until the
# final Enter sends it.
fixture: agents
await idle
key o
await screen == Workspace 20000

key ctrl-s a
await agents.threads[0].provider == claude 20000
await idle 30000
type explain this crate

key ctrl-s m
key enter
assert agents.threads[0].state == idle && lists.tabs.selected.label == Claude

key ctrl-s e
key enter
assert agents.threads[0].state == idle && lists.tabs.selected.label == Claude
dump claude-catalogue-pickers-kept-the-draft

key enter
await agents.threads[0].state == working 20000
await agents.threads[0].state == idle 40000
assert lists.tabs.selected.label == "explain this crate" && sticky_error absent
quit
