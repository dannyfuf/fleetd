# A delegated child starts hidden. The AGENTS picker names that state as `attach`; accepting the
# row adds the child to the mixed strip and focuses its composer.
fixture: agents-subagent
await idle
key o
await screen == Workspace 20000

key ctrl-s a
await agents.threads[0].provider == claude 20000
assert focused == agents.composer
await idle 30000
type delegate the path lookup
key enter
await agents.threads[1].parent exists 30000
assert agents.threads[1].attached == false
await agents.delegations[0].delivery == delivered && agents.threads[0].state != working 30000

key ctrl-s d
await lists.palette.rows[1].badges[1] == child 10000
assert lists.palette.rows[1].marks[1] == attach && lists.palette.rows[1].marks[2] == hidden
key ctrl-u
type agents codex
key enter

await agents.threads[1].attached == true 20000
assert lists.tabs.selected.badges[1] == child && focused == agents.composer
dump attached-from-picker
quit
