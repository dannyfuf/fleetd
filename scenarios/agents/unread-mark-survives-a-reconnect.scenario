fixture: agents
await idle
key o
await screen == Workspace 20000

key ctrl-s a
await agents.threads[0].provider == claude 20000
assert focused == agents.composer
await idle 30000
type first question
key enter

# Watched from start to finish, so the thread is read: no mark, no attention. Both edges of the
# turn are awaited in order, because awaiting `idle` alone holds before the turn has started.
await agents.threads[0].state == working 20000
await agents.threads[0].state == idle 40000
assert agents.threads[0].unread == false && agents.threads[0].state == idle
dump read

# The daemon goes away and comes back. The persisted installation cursor keeps the thread read.
daemon restart
await daemon.link == reconnected 60000
wait 5000
assert agents.threads[0].unread == false && agents.threads[0].state == idle
dump still-read
quit
