# The specialized caller delegates to acme/api#other. The picker exposes that suffix while the
# first worktree is active; accepting the hidden child switches sessions before attaching it.
fixture: agents-subagent-other-worktree
await idle
key down
assert lists.worktrees.selected.id == "acme/api#agent"
key o
await screen == Workspace 20000

key ctrl-s a
await agents.threads[0].provider == claude 20000
assert focused == agents.composer
await idle 30000
type delegate this lookup elsewhere
key enter
await agents.threads[1].parent exists 30000
assert agents.threads[1].attached == false
await agents.delegations[0].delivery == delivered && agents.threads[0].state != working 30000

key ctrl-s d
await lists.palette.rows[1].badges[1] == child 10000
assert lists.palette.rows[1].badges[2] == "acme/api#other" && lists.palette.rows[1].label ~= "acme/api#other$" && lists.palette.rows[1].marks[1] == attach
key ctrl-u
type agents codex
key enter

await agents.threads[1].attached == true 20000
assert lists.tabs.selected.badges[1] == child && focused == agents.composer
dump switched-and-attached
quit
