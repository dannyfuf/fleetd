fixture: agents
await idle
key o
await screen == Workspace 20000
key ctrl-s A
await agents.threads[0].provider == codex 20000
assert focused == agents.composer
await idle 30000
type apply the README fix
key enter
await agents.threads[0].pending_gate == permission 40000
# `pending_gate` reads the broadcast summary; the key chain reads the projection, which can be
# one catch-up round trip behind it. So the context is awaited, never asserted beside the gate.
await key_contexts[2] == AgentPermission 5000
assert agents.threads[0].state == needs_you
dump gated

daemon restart
await daemon.link == reconnected 60000
assert daemon.restarted == true
# The active tab catches up on its own. Reading the settled tail clears its fresh-completion mark,
# so the stopped, resumable thread presents as idle and the composer owns AgentIdle.
await key_contexts[1] == AgentIdle 20000
assert agents.threads[0].pending_gate absent && agents.threads[0].state == idle
dump recovered

# The next message resumes from the durable cursor; the scripted harness reaches its gate again.
type continue
key enter
await agents.threads[0].pending_gate == permission 40000
await key_contexts[2] == AgentPermission 5000
# Watched from the active tab, so the resumed gate never marks the thread unread.
await agents.threads[0].unread == false 5000
assert agents.threads[0].decision.kind == permission
dump resumed
quit
