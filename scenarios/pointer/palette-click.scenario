# UX-SPEC §3.9 · ADR 0023 — the palette by pointer: the title bar's command field opens it, the
# query is typed, and a click on the top *Go to* row opens that worktree as ⏎ would.
# `hub/palette-clicks.scenario` covers a command row and the scrim; this is the navigation half.
#
# Virtual-lane only: it takes shots.
fixture: busy
await idle 30000
assert screen == Hub && overlay absent

click titlebar.command
await overlay == Palette 10000
assert mode == Palette && focused == palette.input
type hotfix
await idle
await targets["palette.row[0]"] exists 5000
shot palette
click palette.row[0]
await screen == Workspace 20000
await lists.tabs.rows[0] exists 20000
assert overlay absent && lists.tabs.rows[0].label ~= "/acme/api/hotfix$"

click workspace.back
await screen == Hub 10000
dump back
quit
