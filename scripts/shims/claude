#!/bin/sh
# Canonicalize PATH directories so symlinks and relative entries cannot recurse.
shim_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd) || exit 127
real=
rest=${PATH-}:
while [ -n "$rest" ]; do
    dir=${rest%%:*}
    rest=${rest#*:}
    [ -n "$dir" ] || dir=.
    canonical=$(CDPATH= cd -P -- "$dir" 2>/dev/null && pwd) || continue
    [ "$canonical" = "$shim_dir" ] && continue
    if [ -f "$canonical/claude" ] && [ -x "$canonical/claude" ]; then
        real=$canonical/claude
        break
    fi
done
if [ -z "$real" ]; then
    echo 'fleet shim: claude not found outside the shim directory' >&2
    exit 127
fi
if [ "${FLEET_TERMINAL_ID+x}" = x ] && [ "${FLEET_WATCH+x}" != x ] && ! [ -t 1 ]; then
    exec "${FLEET_BIN:-fleet}" exec --watch --label claude -- "$real" "$@"
fi
exec "$real" "$@"
